# ─── Servidor ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Base de datos ───────────────────────────────────────────
# MongoDB Atlas → Connect → Drivers → copia la URI y sustituye <password>
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cookr?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Redis / Upstash (rate limiting distribuido, opcional) ───
# Sin estas dos, el rate limiting corre en memoria: funciona, pero se
# reinicia en cada redeploy y no se comparte entre instancias. Con ellas,
# sobrevive a los redeploys. Crear database Redis en upstash.com y copiar
# la REST URL y el token (no la cadena rediss://).
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Email (Mailjet HTTP API) ────────────────────────────────
# Render free bloquea los puertos SMTP (25/465/587), así que se envía por
# la API REST de Mailjet sobre HTTPS (puerto 443, no bloqueado).
# 1. Crear cuenta gratis en mailjet.com (200/día, 6000/mes)
# 2. Account → Senders & Domains → verificar el email remitente (basta un Gmail)
# 3. Account → API Key Management → copiar API Key (pública) y Secret Key (privada)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SENDER_EMAIL=tucuenta@gmail.com
SENDER_NAME=Cookr

# ─── Google OAuth ──────────────────────────────────
# El MISMO valor que GOOGLE_CLIENT_ID del frontend. El backend lo usa como
# audience al verificar el id_token con google-auth-library: si no coincide
# con el cliente que emitió el token, la verificación falla y el login
# responde 401. Sin esta variable, POST /api/auth/google responde 503.
GOOGLE_CLIENT_ID=

# ─── Servicios externos ──────────────────────────────────────
GEMINI_API_KEY=
# Modelo fijo para precio predecible. No uses alias "-latest" en producción.
GEMINI_MODEL=gemini-2.0-flash
# Tope global de llamadas a Gemini por día en todo el backend (red de seguridad de coste)
GEMINI_MAX_LLAMADAS_DIA=1000
# Proxy opcional (Cloudflare Worker) para hosting cuya IP bloquea el nivel gratuito de
# Gemini, como Render. En local déjalo vacío y las llamadas van directas. Ver gemini-proxy/.
GEMINI_BASE_URL=
GEMINI_PROXY_TOKEN=
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
# Almacenamiento de imágenes. Sin esto, POST /api/subidas/firma responde 503 y no se puede
# subir ninguna foto. Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=