# ─── Servidor ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Base de datos ───────────────────────────────────────────
# MongoDB Atlas → Connect → Drivers → copia la URI y sustituye <password>
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cookr?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── CORS ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Redis / Upstash (Sprint 3+) ─────────────────────────────
# Crear cuenta en upstash.com → nuevo database Redis → copiar URL y token
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Email (Gmail SMTP) ──────────────────────────────────────
# 1. Gmail → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
# 2. Crear una para "Correo" → copiar los 16 caracteres
# Funciona en dev y prod sin dominio propio (~500 emails/día)
GMAIL_USER=tucuenta@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Servicios externos ──────────────────────────────────────
GEMINI_API_KEY=
# Modelo fijo para precio predecible. No uses alias "-latest" en producción.
GEMINI_MODEL=gemini-2.0-flash
# Tope global de llamadas a Gemini por día en todo el backend (red de seguridad de coste)
GEMINI_MAX_LLAMADAS_DIA=1000
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
CLOUDINARY_URL=


// cCuenta de prueba activa para login 
