{
  "name": "cookr-backend",
  "version": "1.0.0",
  "description": "API REST — Cookr TFG",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "ts-node --transpile-only src/scripts/seed.ts",
    "seed:force": "ts-node --transpile-only src/scripts/seed.ts -- --force",
    "seed:completo": "ts-node --transpile-only src/scripts/seedCompleto.ts",
    "seed:completo:force": "ts-node --transpile-only src/scripts/seedCompleto.ts -- --force",
    "seed:masivo": "ts-node --transpile-only src/scripts/seedMasivo.ts",
    "seed:masivo:sin-imagenes": "ts-node --transpile-only src/scripts/seedMasivo.ts -- --sin-imagenes",
    "limpiar:test": "ts-node --transpile-only src/scripts/limpiarDatosTest.ts",
    "avatares:seed": "ts-node --transpile-only src/scripts/actualizarAvataresSeed.ts",
    "normalizar:categorias": "ts-node --transpile-only src/scripts/normalizarCategorias.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@types/nodemailer": "^8.0.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.5",
    "resend": "^6.12.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
